{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gbkel-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
