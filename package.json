{
  "name": "gbkel-redirects",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "build:sync-domain-aliases": "node src/Setup/CliSetup.ts sync --adapter netlify",
    "build": "pnpm build:sync-domain-aliases && pnpm build:site",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint --cache --cache-strategy content",
    "quality": "knip && jscpd && dpdm --no-warning --no-tree --exit-code circular:1 --transform --tsconfig tsconfig.json \"src/**/*.ts\"",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "ensure-deps": "node scripts/ensure-deps.mjs",
    "lint-staged": "lint-staged",
    "check:changed": "node scripts/check-changed.mjs",
    "check": "pnpm ensure-deps && pnpm typecheck && pnpm lint && pnpm quality && pnpm test && pnpm check:aliases",
    "sync": "node src/Setup/CliSetup.ts sync",
    "check:aliases": "node src/Setup/CliSetup.ts check",
    "build:site": "node src/Setup/SiteSetup.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermebkel/gbkel-redirects.git"
  },
  "license": "ISC",
  "dependencies": {
    "netlify": "^6.1.22"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22",
    "@vitest/eslint-plugin": "^1.6.28",
    "dpdm": "^4.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
