NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=
CAPROVER_URL=https://captain.example.com
CAPROVER_PASSWORD=
CAPROVER_APP=
# Token with Zone:DNS:Edit on the zone, the zone name, and the host every claimed alias points to (a CNAME).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=example.com
CLOUDFLARE_CNAME_TARGET=captain.example.com
# The server inside the image (ServerSetup): where it reads the aliases and how often it reloads them.
ALIASES_URL=
ALIASES_FILE=domainAliases.json
ALIASES_RELOAD_SECONDS=300
PORT=3000
